{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "WebSearch",
      "Read",
      "Grep",
      "Glob",
      "LSP",
      "Read(./src/**)",
      "LSP(./src/**)",
      "Edit(./src/**)",
      "Edit(//temp/**)",
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(grep *)",
      "Bash(for *)",
      "Bash(jq *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(xargs *)",
      "Bash(./gradlew *)",
      "Bash(npx *)",
      "Bash(python3 *)",
      "Bash(tee *)",
      "Bash(pnpm *)",
      "Bash(make *)",
      "Bash(terraform fmt *)"
    ],
    "deny": [
      "WebFetch",
      "Bash(sudo *)",
      "Bash(wget *)",
      "Bash(curl *)",
      "Bash(rm *)",
      "Bash(rm -rf *)",
      "Read(.npmrc)",
      "Read(.env)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"指示待ちです\" with title \"Claude Code\" subtitle \"指示待ち\" sound name \"Hero\"'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/sahashi/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"タスクが完了しました\" with title \"Claude Code\" subtitle \"処理終了\" sound name \"Hero\"'"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "codex@openai-codex": true
  },
  "statusLine": {
    "type": "command",
    "command": "npx ccstatusline@latest"
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "language": "日本語",
  "tui": "fullscreen",
  "agentPushNotifEnabled": true
}
